{
  "info": {
    "name": "TechFlow API",
    "_postman_id": "8b78bb7d-9c8e-4c19-9c70-techflow2026",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "token", "value": ""},
    {"key": "projectId", "value": "1"},
    {"key": "taskId", "value": "1"}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Alice Silva\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"Senha@123\"\n}"},
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Senha@123\"\n}"},
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {"name": "Me", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/api/v1/users/me"}}
      ]
    },
    {
      "name": "Projects",
      "item": [
        {"name": "Create", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"TechFlow\",\n  \"description\": \"Projeto de portfólio\",\n  \"status\": \"PLANNED\"\n}"}, "url": "{{baseUrl}}/api/v1/projects"}},
        {"name": "List", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/api/v1/projects?page=0&size=20"}},
        {"name": "Get", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"}},
        {"name": "Update", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"TechFlow atualizado\",\n  \"description\": \"Projeto atualizado\",\n  \"status\": \"IN_PROGRESS\"\n}"}, "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"}},
        {"name": "Delete", "request": {"method": "DELETE", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"}}
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {"name": "Create", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}], "body": {"mode": "raw", "raw": "{\n  \"title\": \"Implementar autenticação\",\n  \"description\": \"JWT + Spring Security\",\n  \"priority\": \"HIGH\",\n  \"dueDate\": \"2026-10-15\"\n}"}, "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks"}},
        {"name": "List", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks?page=0&size=20"}},
        {"name": "Get", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"}},
        {"name": "Status", "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}], "body": {"mode": "raw", "raw": "{\n  \"status\": \"DONE\"\n}"}, "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/status"}},
        {"name": "Delete", "request": {"method": "DELETE", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"}}
      ]
    }
  ]
}
